{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "SPM: Canonical Tests",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "-m",
                "pytest",
                "-q",
                "tests",
                "-k",
                "not test_webui_backup_zip_exists"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONPATH": "${workspaceFolder}"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "SPM: Compile Main Application",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "-m",
                "py_compile",
                "core/application/operator_workstation_software.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "SPM: Launch Application",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "run_spm.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONPATH": "${workspaceFolder}",
                    "SPM_WEB_ALLOW_READONLY_HARDWARE": "1"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "SPM: Launch Single Monitor Workspace",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "run_spm.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYTHONPATH": "${workspaceFolder}",
                    "SPM_WEB_ALLOW_READONLY_HARDWARE": "1"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "DORO: Spark Local AI",
            "type": "shell",
            "command": "spark-code",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true,
                "clear": false
            }
        }
    ]
}
